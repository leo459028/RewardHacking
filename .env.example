# ==============================================================================
# RewardHacking Guardrail - Environment Configuration Template
# Version: v1.5.6
#
# Copy this file to '.env' and modify for your local/production environment:
#   cp .env.example .env
# NOTE: Never commit sensitive credentials or production keys into Git!
# ==============================================================================

# Application & Server Core Settings
APP_NAME=reward-hacking-guardrail
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Infrastructure Connections (Postgres, Redis, Kafka)
# Local defaults point to localhost for native development; Docker Compose overrides these.
POSTGRES_DSN=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Event Bus Topics
KAFKA_REQUEST_TOPIC=agent.requests
KAFKA_DECISION_TOPIC=agent.decisions
KAFKA_EXECUTION_TOPIC=agent.executions
KAFKA_EVALUATION_TOPIC=agent.evaluations
KAFKA_INCIDENT_TOPIC=agent.incidents

# Guardrail & Safety Engine Policies
DEFAULT_MAX_TOOL_CALLS=8
DEFAULT_RISK_THRESHOLD=0.65
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=30
APPROVAL_TTL_SECONDS=3600
WORKER_COMPLETION_LATENCY_TARGET_SECONDS=300
INCIDENT_RESPONSE_TARGET_SECONDS=900
LLM_JUDGE_ENABLED=false

# v1.5.10 advisory judge triage (ordering only; never changes verdicts) and review sampling
EVALUATION_JUDGE_MODE=shadow
EVALUATION_JUDGE_PROVIDER=deterministic
# For openai_compatible: EVALUATION_JUDGE_BASE_URL=http://localhost:11434/v1, EVALUATION_JUDGE_MODEL=<model>,
# EVALUATION_JUDGE_API_KEY=<token>; hosted endpoints also need EVALUATION_JUDGE_ALLOW_EXTERNAL=true
EVALUATION_SAMPLING_ENABLED=true
EVALUATION_SAMPLE_RANDOM_RATE=0.02
# Set a long random value in production so random-audit draws are reproducible across restarts
EVALUATION_SAMPLE_SECRET=

# v1.5.11 judge profiles: copy config/judge_profiles.example.yaml to config/judge_profiles.yaml, then pick one
EVALUATION_JUDGE_PROFILE=default
EVALUATION_JUDGE_PROFILES_FILE=config/judge_profiles.yaml
EVALUATION_JUDGE_BACKGROUND_CONCURRENCY=1
# v1.5.12 judge activation: an LLM profile is used only after a successful connection test (and, for profiles
# created on /dashboard/judge-profiles, an explicit activation). Keys stay in environment variables named *_API_KEY.
EVALUATION_JUDGE_ACTIVATION_REFRESH_SECONDS=30
EVALUATION_JUDGE_PROBE_MAX_AGE_HOURS=24
EVALUATION_JUDGE_KEY_ENV_ALLOWLIST=
EVALUATION_JUDGE_BREAKER_FAILURE_THRESHOLD=3
EVALUATION_JUDGE_BREAKER_TTL_SECONDS=300
# auto = Dashboard may edit judge profiles only with DASHBOARD_AUTH_ENABLED=true and non-default credentials;
# off = read-only; insecure_dev = local development only (browser E2E QA stack uses it).
EVALUATION_JUDGE_DASHBOARD_EDITING=auto

# Authentication & RBAC-lite Bootstrap
# Format: <key>:<tenant_id>:<role> (role: admin | operator | viewer)
AUTH_ENABLED=false
API_KEYS=demo-key:default:admin

# v1.6.1 Dashboard sign-in (personal accounts, server-side sessions; Basic Auth was removed).
# DASHBOARD_AUTH_MODE: off (no sign-in, local development only) | session (sign-in required).
# Unset -> derived from DASHBOARD_AUTH_ENABLED (true -> session, false -> off).
# Create the first admin with: python -m app.jobs.users create --username <name> --role admin --password-env <VAR>
DASHBOARD_AUTH_ENABLED=false
# DASHBOARD_AUTH_MODE=session
# auto = Secure cookie unless APP_ENV=dev | true | false
DASHBOARD_COOKIE_SECURE=auto
DASHBOARD_SESSION_IDLE_MINUTES=30
DASHBOARD_SESSION_MAX_HOURS=8
DASHBOARD_REAUTH_MAX_AGE_SECONDS=300
# Signs the short-lived sign-in form CSRF cookie; empty = random per process (set it for several API replicas).
# DASHBOARD_CSRF_SECRET=
DASHBOARD_LOGIN_MAX_FAILURES=5
DASHBOARD_LOGIN_LOCKOUT_MINUTES=15
DASHBOARD_PASSWORD_MIN_LENGTH=12
# scrypt cost (N must be a power of 2; about 128 * N * R bytes of memory per hash)
DASHBOARD_PASSWORD_SCRYPT_N=32768
DASHBOARD_PASSWORD_SCRYPT_R=8
DASHBOARD_PASSWORD_SCRYPT_P=3
# Deprecated since v1.6.1 and ignored (the operations check warns when they differ from admin / admin).
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=admin

# Tenant, User & Tool Quota & Circuit Breakers (Redis-backed, v1.5.6)
QUOTA_ENABLED=true
TENANT_REQUEST_LIMIT_PER_MINUTE=60
TENANT_HIGH_RISK_LIMIT_PER_HOUR=10
USER_REQUEST_LIMIT_PER_MINUTE=30
TOOL_CALL_LIMIT_PER_MINUTE=60
TOOL_BREAKER_FAILURE_THRESHOLD=3
TOOL_BREAKER_TTL_SECONDS=1800
MCP_SERVER_CALL_LIMIT_PER_MINUTE=90
MCP_SCHEMA_ENFORCEMENT_MODE=deny
MCP_INTERNAL_HOST_SUFFIXES=.internal.local,.mcp.internal
MCP_TOOL_ARGUMENTS_MAX_DEPTH=8
MCP_TOOL_ARGUMENTS_MAX_BYTES=65536

# Operations Gate, Audit Retention & Evidence Lifecycle
AUDIT_RETENTION_DAYS=90
# v1.6.0 retention purge: off | plan (default: plans only, apply refused) | apply
AUDIT_RETENTION_PURGE_MODE=plan
AUDIT_RETENTION_PURGE_BATCH_SIZE=500
AUDIT_RETENTION_PLAN_TTL_MINUTES=60
# FinOps ledger (usage / cost / budget violations) is report-only, never deleted
FINOPS_LEDGER_RETENTION_DAYS=2555
# v1.6.1 audit chain: every governance event, review / approval decision, tombstone and checkpoint is hash-linked
# in audit_chain_entries (never purged). Checkpoints are signed with an Ed25519 key kept apart from the database;
# without a key they are written as "unsigned" (operations check warns; fails in APP_ENV=prod).
AUDIT_CHAIN_ENABLED=true
# AUDIT_CHAIN_SIGNING_KEY_FILE=config/audit_chain_key.pem
# AUDIT_CHAIN_SIGNING_KEY=
# AUDIT_CHAIN_PUBLIC_KEYS_FILE=config/audit_chain_public_keys.pem
AUDIT_CHAIN_VERIFY_MAX_ENTRIES=5000

# v1.6.0 sandbox spec: "simulated" is the only backend (nothing is executed); isolation is recorded, not enforced.
# Levels: simulated < process < container < gvisor < microvm. Unset or empty threshold = DEFAULT_RISK_THRESHOLD.
# Maximums must be greater than 0 (otherwise the worker refuses to start tool execution).
SANDBOX_BACKEND=simulated
# SANDBOX_HIGH_RISK_THRESHOLD=0.65
SANDBOX_MIN_ISOLATION_DEFAULT=container
SANDBOX_MIN_ISOLATION_HIGH_RISK=gvisor
SANDBOX_MAX_TIMEOUT_SECONDS=300
SANDBOX_MAX_OUTPUT_BYTES=1048576
OPERATIONS_EVIDENCE_MAX_AGE_DAYS=30
SECRET_ROTATION_MAX_AGE_DAYS=90
RELEASE_GATE_MAX_QUEUED_AGE_MINUTES=15
RELEASE_GATE_FAIL_ON_BOOTSTRAP_KEYS_IN_PROD=true

# Agent FinOps Core, Burn-Rate Forecasting & Dynamic Token Broker (v1.5.6)
FINOPS_BUDGET_ENFORCEMENT_ENABLED=true
FINOPS_BASE_CURRENCY=USD
FINOPS_DEFAULT_TAX_RATE=0
FINOPS_FX_RATES={"USD":1,"CNY":0.14,"EUR":1.08,"GBP":1.27,"JPY":0.0067,"TWD":0.031,"HKD":0.128,"SGD":0.74}
FINOPS_FX_RATES_AS_OF=2026-10-01
FINOPS_EXPORT_MAX_ROWS=10000
FINOPS_BURN_RATE_WINDOW_HOURS=24
FINOPS_BURN_RATE_MIN_ELAPSED_HOURS=6
FINOPS_BURN_RATE_MIN_SAMPLES=2
FINOPS_TOKEN_LEASE_TTL_SECONDS=7200

# v1.6.0: optional OpenTelemetry export (pip install .[otel]; the Docker image installs it).
# Start Jaeger with `docker compose --profile observability up -d`, then rebuild api / worker.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACE_UI_URL_TEMPLATE=
